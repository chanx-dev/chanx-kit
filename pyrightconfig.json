{
  "include": [
    "python",
    "scripts",
    "tests",
    "src",
    "docs",
    "templates/fastapi-react/app"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    ".venv",
    "python/kits/pipecat_bridge"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.11",
  "reportMissingTypeStubs": false,
  "reportPrivateUsage": false,
  "executionEnvironments": [
    {
      "root": "python/sandbox",
      "extraPaths": [
        "python"
      ],
      "reportMissingImports": "none",
      "reportUnknownVariableType": "none",
      "reportUnknownMemberType": "none"
    },
    {
      "root": "tests",
      "extraPaths": [
        ".",
        "scripts",
        "python"
      ],
      "reportUnknownVariableType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownParameterType": "none",
      "reportMissingImports": "none"
    },
    {
      "root": "scripts",
      "reportUnknownVariableType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownArgumentType": "none",
      "extraPaths": [
        "python"
      ]
    },
    {
      "root": "docs",
      "extraPaths": [
        ".",
        "python"
      ],
      "reportUnknownVariableType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownArgumentType": "none"
    },
    {
      "root": "python",
      "extraPaths": [
        "python"
      ]
    },
    {
      "root": "src"
    },
    {
      "root": "templates/fastapi-react",
      "extraPaths": [
        "templates/fastapi-react"
      ]
    }
  ],
  "reportUnusedFunction": false,
  "reportUnnecessaryCast": false
}
