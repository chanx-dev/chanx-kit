    "voice-agent": {
      "name": "voice-agent",
      "title": "Voice agent",
      "description": "Talk to an AG-UI agent: what you say is transcribed and sent as a turn, the reply is spoken sentence by sentence as it streams, and speaking over it interrupts, keeping only what was actually heard. Composes the AG-UI, transcriber and synthesizer kits.",
