{
  "version": 1,
  "name": "chanx-kit-go",
  "title": "chanx-kit Go",
  "description": "Copy-in WebSocket components for chanx-go, speaking the same contracts as the Python kits.",
  "source": "github:chanx-dev/chanx-kit",
  "homepage": "https://github.com/chanx-dev/chanx-kit",
  "ecosystem": "go",
  "variants": [],
  "install": {
    "target": "internal/wskits",
    "module_path": "go.chanx.dev/kit/kits",
    "exclude": [
      "kit.yaml"
    ],
    "optional": {
      "tests": [
        "*_test.go",
        "testdata/**"
      ]
    }
  },
  "components": {
    "ag-ui": {
      "name": "ag-ui",
      "title": "AG-UI",
      "description": "Serve the AG-UI agent-user interaction protocol over a websocket, so any AG-UI frontend works unchanged. Provider-agnostic: yield events from any agent. Optionally broadcasts a run to every connection on its thread, replaying it to late joiners.",
      "tier": "core",
      "version": "0.2.0",
      "path": "go/kits/agui",
      "tags": [
        "agent",
        "ag-ui",
        "protocol",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "contract.go",
        "messages.go",
        "schema.json",
        "store.go",
        "topics.go"
      ],
      "optional": {
        "tests": [
          "agui_test.go"
        ]
      }
    },
    "audio-stream-in": {
      "name": "audio-stream-in",
      "title": "Audio stream in",
      "description": "Stream microphone audio in over the socket and get transcripts back, from any speech-to-text provider. Speaks the transcriber contract; provider kits plug in a stream. Bounded streams, per-user limits, gap detection and watcher fan-out.",
      "tier": "core",
      "version": "0.1.0",
      "path": "go/kits/audiostreamin",
      "tags": [
        "audio",
        "speech-to-text",
        "transcription",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "media-stream-in"
      ],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "messages.go",
        "provider.go",
        "topics.go"
      ],
      "optional": {
        "tests": [
          "audiostreamin_test.go"
        ]
      }
    },
    "audio-stream-out": {
      "name": "audio-stream-out",
      "title": "Audio stream out",
      "description": "Speak text to a session's listeners from any text-to-speech provider. Speaks the synthesizer contract; provider kits plug in audio. Utterances queue in order, an interruption clears them, late joiners are replayed, and playback marks record what was actually heard.",
      "tier": "core",
      "version": "0.1.0",
      "path": "go/kits/audiostreamout",
      "tags": [
        "audio",
        "text-to-speech",
        "speech",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "media-stream-out"
      ],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "messages.go",
        "playback.go",
        "topics.go"
      ],
      "optional": {
        "tests": [
          "audiostreamout_test.go"
        ]
      }
    },
    "deepgram": {
      "name": "deepgram",
      "title": "Deepgram",
      "description": "Deepgram behind the voice contracts: live speech-to-text (Nova) and streaming text-to-speech (Aura). Install both, or one part with `--only stt` or `--only tts`. The API key stays on the server.",
      "tier": "contrib",
      "version": "0.1.0",
      "path": "go/kits/deepgram",
      "tags": [
        "audio",
        "speech-to-text",
        "text-to-speech",
        "deepgram",
        "provider"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "audio-stream-in",
        "audio-stream-out"
      ],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0",
        "github.com/coder/websocket@v1.8.15"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "deepgram.go",
        "synthesizer.go",
        "transcriber.go"
      ],
      "optional": {
        "tests": [
          "fake_test.go",
          "synthesizer_test.go",
          "transcriber_test.go"
        ]
      },
      "parts": {
        "stt": {
          "include": [
            "deepgram.go",
            "transcriber.go",
            "fake_test.go",
            "transcriber_test.go"
          ],
          "requires": [
            "audio-stream-in"
          ]
        },
        "tts": {
          "include": [
            "deepgram.go",
            "synthesizer.go",
            "fake_test.go",
            "synthesizer_test.go"
          ],
          "requires": [
            "audio-stream-out"
          ]
        }
      }
    },
    "elevenlabs": {
      "name": "elevenlabs",
      "title": "ElevenLabs",
      "description": "ElevenLabs behind the voice contracts: realtime speech-to-text (Scribe) and streaming text-to-speech. Install both, or one part with `--only stt` or `--only tts`. The API key stays on the server.",
      "tier": "contrib",
      "version": "0.1.0",
      "path": "go/kits/elevenlabs",
      "tags": [
        "audio",
        "speech-to-text",
        "text-to-speech",
        "elevenlabs",
        "provider"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "audio-stream-in",
        "audio-stream-out"
      ],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0",
        "github.com/coder/websocket@v1.8.15"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "elevenlabs.go",
        "synthesizer.go",
        "transcriber.go"
      ],
      "optional": {
        "tests": [
          "fake_test.go",
          "synthesizer_test.go",
          "transcriber_test.go"
        ]
      },
      "parts": {
        "stt": {
          "include": [
            "elevenlabs.go",
            "transcriber.go",
            "fake_test.go",
            "transcriber_test.go"
          ],
          "requires": [
            "audio-stream-in"
          ]
        },
        "tts": {
          "include": [
            "elevenlabs.go",
            "synthesizer.go",
            "fake_test.go",
            "synthesizer_test.go"
          ],
          "requires": [
            "audio-stream-out"
          ]
        }
      }
    },
    "fake-voice": {
      "name": "fake-voice",
      "title": "Fake voice",
      "description": "A transcriber and a synthesizer that need no provider and no key: speech is transcribed as a scripted sentence, text is spoken as a tone per word. For demos, UI work and CI. Install both, or one part with `--only stt` or `--only tts`.",
      "tier": "core",
      "version": "0.1.0",
      "path": "go/kits/fakevoice",
      "tags": [
        "audio",
        "speech-to-text",
        "text-to-speech",
        "testing",
        "demo"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "audio-stream-in",
        "audio-stream-out"
      ],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "synthesizer.go",
        "transcriber.go"
      ],
      "optional": {
        "tests": [
          "synthesizer_test.go",
          "transcriber_test.go"
