{
  "version": 1,
  "name": "chanx-kit-js",
  "title": "chanx-kit JS",
  "description": "Copy-in WebSocket components for chanx-js servers, speaking the same contracts as the Python kits.",
  "source": "github:chanx-dev/chanx-kit",
  "homepage": "https://github.com/chanx-dev/chanx-kit",
  "ecosystem": "node",
  "variants": [],
  "install": {
    "target": "src/ws-kits",
    "exclude": [
      "kit.yaml"
    ],
    "optional": {
      "tests": [
        "tests/**"
      ]
    }
  },
  "components": {
    "ag-ui": {
      "name": "ag-ui",
      "title": "AG-UI",
      "description": "Serve the AG-UI agent-user interaction protocol over a websocket, so any AG-UI frontend works unchanged. Provider-agnostic: yield events from any agent. Optionally broadcasts a run to every connection on its thread, replaying it to late joiners.",
      "tier": "core",
      "version": "0.1.0",
      "path": "js/kits/ag-ui",
      "tags": [
        "agent",
        "ag-ui",
        "protocol",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [],
      "dependencies": [
        "@chanx-js/server@^2.2.0",
        "@ag-ui/core@^1.0.4",
        "zod@^4.1.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "index.ts",
        "messages.ts",
        "schema.ts",
        "store.ts",
        "topics.ts"
      ],
      "optional": {
        "tests": {
          "include": [
            "tests/ag-ui.test.ts"
          ],
          "dependencies": [
            "vitest@^3.2.4"
          ]
        }
      }
    },
    "audio-stream-in": {
      "name": "audio-stream-in",
      "title": "Audio stream in",
      "description": "Stream microphone audio in over the socket and get transcripts back, from any speech-to-text provider. Speaks the transcriber contract; provider kits plug in a stream. Bounded streams, per-user limits, gap detection and watcher fan-out.",
      "tier": "core",
      "version": "0.1.0",
      "path": "js/kits/audio-stream-in",
      "tags": [
        "audio",
        "speech-to-text",
        "transcription",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "media-stream-in"
      ],
      "dependencies": [
        "@chanx-js/server@^2.2.0",
        "zod@^4.1.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "index.ts",
        "messages.ts",
        "provider.ts",
        "topics.ts"
      ],
      "optional": {
        "tests": {
          "include": [
            "tests/audio-stream-in.test.ts"
          ],
          "dependencies": [
            "vitest@^3.2.4"
          ]
        }
      }
    },
    "audio-stream-out": {
      "name": "audio-stream-out",
      "title": "Audio stream out",
      "description": "Speak text to a session's listeners from any text-to-speech provider. Speaks the synthesizer contract; provider kits plug in audio. Utterances queue in order, an interruption clears them, late joiners are replayed, and playback marks record what was actually heard.",
      "tier": "core",
      "version": "0.1.0",
      "path": "js/kits/audio-stream-out",
      "tags": [
        "audio",
        "text-to-speech",
        "speech",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "media-stream-out"
      ],
      "dependencies": [
        "@chanx-js/server@^2.2.0",
        "zod@^4.1.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "index.ts",
        "messages.ts",
        "playback.ts",
        "topics.ts"
      ],
      "optional": {
        "tests": {
          "include": [
            "tests/audio-stream-out.test.ts"
          ],
          "dependencies": [
            "vitest@^3.2.4"
          ]
        }
      }
    },
    "deepgram": {
      "name": "deepgram",
      "title": "Deepgram",
      "description": "Deepgram behind the voice contracts: live speech-to-text (Nova) and streaming text-to-speech (Aura). Install both, or one part with `--only stt` or `--only tts`. The API key stays on the server.",
      "tier": "contrib",
      "version": "0.1.0",
      "path": "js/kits/deepgram",
      "tags": [
        "audio",
        "speech-to-text",
        "text-to-speech",
        "deepgram",
        "provider"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "audio-stream-in",
        "audio-stream-out"
      ],
      "dependencies": [
        "@chanx-js/server@^2.2.0",
        "ws@^8.18.0"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "deepgram.ts",
        "index.ts",
        "synthesizer.ts",
        "transcriber.ts"
      ],
      "optional": {
        "tests": {
          "include": [
            "tests/fake.ts",
            "tests/synthesizer.test.ts",
            "tests/transcriber.test.ts"
          ],
          "dependencies": [
            "vitest@^3.2.4"
          ]
        }
      },
      "parts": {
        "stt": {
          "include": [
            "deepgram.ts",
            "transcriber.ts",
            "tests/fake.ts",
            "tests/transcriber.test.ts"
          ],
          "requires": [
            "audio-stream-in"
          ]
        },
        "tts": {
          "include": [
            "deepgram.ts",
            "synthesizer.ts",
            "tests/fake.ts",
            "tests/synthesizer.test.ts"
          ],
          "requires": [
            "audio-stream-out"
          ]
        }
      }
    },
