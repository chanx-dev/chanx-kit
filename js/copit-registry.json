    "media-stream-in": {
      "name": "media-stream-in",
      "title": "Media stream in",
      "description": "The plumbing for media a client streams in: bytes that travel as base64, chunks put back in order with gaps reported, and a bounded real-time intake with keepalive and idle handling. The base the audio kits build on.",
      "tier": "core",
      "version": "0.1.0",
      "path": "js/kits/media-stream-in",
