        "tts": {
          "include": [
            "synthesizer.go",
            "synthesizer_test.go"
          ],
          "requires": [
            "audio-stream-out"
          ]
        }
      }
    },
    "media-stream-in": {
      "name": "media-stream-in",
      "title": "Media stream in",
      "description": "The plumbing for media a client streams in: chunks put back in order with gaps reported, and a bounded real-time intake with keepalive and idle handling. The base the audio kits build on.",
      "tier": "core",
      "version": "0.1.0",
      "path": "go/kits/mediastreamin",
      "tags": [
        "media",
        "streaming",
        "audio",
        "bytes"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [],
      "dependencies": [
        "go.chanx.dev/v2@v2.2.0"
      ],
      "variants": {},
      "only_variants": [],
